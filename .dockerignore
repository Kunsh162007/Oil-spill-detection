# Build context hygiene. Without this the 1.4 GB venv and 1.6 GB of raw
# imagery get shipped to the daemon on every build.
.venv/
.git/
.pytest-tmp/
.pytest_cache/
__pycache__/
**/__pycache__/
*.pyc

# Data is generated at build time or mounted at run time, never baked from
# the working tree - a developer's local scratch must not end up in an image.
data/
# ...but the build writes its analyses here and the container must
# ship them; excluding these puts us back to analysing per request.
!data/precomputed/
!data/precomputed/**
# Real Sentinel-1 scenes (~100 MB). Without these the deployed map shows
# only the synthetic demo, while the local one shows detections across
# five ocean basins.
!data/live/
!data/live/**
!data/demo_finale/
!data/demo_finale/**
runs/
models/*.pt
models/*.pth
models/*.onnx

# Local-only
.env
htmlcov/
.coverage
*.log
