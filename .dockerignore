# Build context hygiene. Without this the 1.4 GB venv and 1.6 GB of raw
# imagery get shipped to the daemon on every build.
.venv/
.git/
.pytest-tmp/
.pytest_cache/
__pycache__/
**/__pycache__/
*.pyc

# Imagery never enters the image. The API serves a PRECOMPUTED analysis and
# never opens a raster to do it (see api/store.py), so the container needs the
# scene manifests and the cached results - about 600 KB - rather than the
# ~100 MB of GeoTIFFs they were derived from.
data/
!data/precomputed/*.pkl
!data/live/*.json
!data/demo_finale/*.json
# data/dev/ stays out on purpose: those manifests have no cached analysis, so
# shipping them would list scenes the container cannot serve.

runs/
models/*.pt
models/*.pth
models/*.onnx

# Local-only
.env
htmlcov/
.coverage
*.log
