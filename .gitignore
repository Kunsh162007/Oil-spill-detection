.venv/
__pycache__/
*.pyc
.env
models/*.pt
models/*.pth
models/*.onnx
models/*.joblib
data/cache/
data/**/*.tif
data/**/*.tiff
data/**/*.SAFE/
data/**/*.zip
data/**/*.nc
runs/*/
.pytest_cache/
.coverage
htmlcov/
*.egg-info/
.pytest-tmp/
data/raw/
data/reference/*.csv
data/dev/*_manifest.json
data/dev/scenes/
data/live/
# ...except the manifests. They are a few KB each and the deployed container
# needs them to discover a scene at all - a precomputed analysis with no
# manifest behind it is never loaded. The imagery stays out via the *.tif rule.
!data/live/*.json
data/demo_finale/*.tif

# Derived at build time by scripts/precompute.py from the .pkl files
# beside it; regenerating is cheap and a stale copy is worse than none.
data/precomputed/world_index.json

# Per-cell ERA5 responses. A cache: free to refetch, and the
# PANGAEA extraction alone adds a couple of hundred files.
data/wind/openmeteo/
